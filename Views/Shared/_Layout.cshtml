@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject AkarangaBank.Web.Data.AkarangaBankContext BankContext
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isManagePage = currentPage.Contains("/Manage", StringComparison.OrdinalIgnoreCase);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isClient = User.IsInRole("client");
    var clientHasActiveAccount = !isClient;
    if (isAuthenticated && isClient && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
    {
        var clientId = await BankContext.Users.AsNoTracking()
            .Where(user => user.Id == currentUserId)
            .Select(user => user.ClientId)
            .FirstOrDefaultAsync();
        clientHasActiveAccount = clientId.HasValue && await BankContext.Comptes.AsNoTracking()
            .AnyAsync(account => account.ClientId == clientId.Value && account.Statut == "Actif");
    }
    string ActiveFor(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "is-active"
            : string.Empty;
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

@if (isAuthenticated)
{
    <div class="bank-app-shell">
        <aside class="bank-sidebar no-print">
            <a class="bank-brand" asp-controller="@(User.IsInRole("admin") || User.IsInRole("gestionnaire") || User.IsInRole("client") ? "Home" : "Clients")" asp-action="Index" aria-label="AkarangaBank, accueil">
                <span class="bank-brand-mark" aria-hidden="true">AK</span>
                <span class="bank-brand-copy"><strong>AkarangaBank</strong><small data-i18n="nav.workspace">Espace bancaire</small></span>
            </a>

            <nav class="bank-sidebar-nav" aria-label="Navigation principale">
                @if (User.IsInRole("admin") || User.IsInRole("gestionnaire"))
                {
                    <p class="sidebar-section-label" data-i18n="nav.overview">VUE D’ENSEMBLE</p>
                    <a class="bank-nav-link @ActiveFor("Home", "Index")" asp-controller="Home" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z" /></svg><span data-i18n="nav.dashboard">Tableau de bord</span></a>
                }

                @if (User.IsInRole("client"))
                {
                    <p class="sidebar-section-label">MON ESPACE</p>
                }
                else
                {
                    <p class="sidebar-section-label" data-i18n="nav.customers">CLIENTS ET AGENCES</p>
                }
                @if (!User.IsInRole("client"))
                {
                    <a class="bank-nav-link @ActiveFor("Clients")" asp-controller="Clients" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 8v6M23 11h-6" /></svg><span data-i18n="nav.clients">Clients</span></a>
                }
                @if (!isClient || !clientHasActiveAccount)
                {
                    <a class="bank-nav-link @ActiveFor("Agences")" asp-controller="Agences" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 21h18M5 21V8l7-4 7 4v13M9 21v-5h6v5M8 10h.01M12 10h.01M16 10h.01" /></svg><span data-i18n="nav.agencies">Agences</span></a>
                }
                @if (!isClient || clientHasActiveAccount)
                {
                    <a class="bank-nav-link @ActiveFor("Comptes")" asp-controller="Comptes" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v13H3zM3 10h18M7 15h4M17 15h.01M6 3h12" /></svg><span>@(isClient ? "Mon compte" : "Comptes")</span></a>
                }
                @if (User.IsInRole("auditeur") || User.IsInRole("admin") || User.IsInRole("gestionnaire"))
                {
                    <a class="bank-nav-link @ActiveFor("Rapports")" asp-controller="Rapports" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3h9l5 5v13H6zM14 3v6h6M9 14h8M9 18h8" /></svg><span>Rapports</span></a>
                }

                @if (!isClient || clientHasActiveAccount)
                {
                    <p class="sidebar-section-label" data-i18n="nav.operations">OPÉRATIONS</p>
                    <a class="bank-nav-link @ActiveFor("Operations", "Journal")" asp-controller="Operations" asp-action="Journal"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 1 4 17.5zM4 5h13M8 9h8M8 13h8M8 17h5" /></svg><span data-i18n="nav.journal">Journal</span></a>
                }
                @if (User.IsInRole("admin") || User.IsInRole("gestionnaire") || User.IsInRole("guichetier"))
                {
                    <a class="bank-nav-link @ActiveFor("Operations", "Depot")" asp-controller="Operations" asp-action="Depot"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg><span data-i18n="nav.deposit">Dépôt</span></a>
                    <a class="bank-nav-link @ActiveFor("Operations", "Retrait")" asp-controller="Operations" asp-action="Retrait"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21V9M7 14l5-5 5 5M4 4h16" /></svg><span data-i18n="nav.withdrawal">Retrait</span></a>
                    <a class="bank-nav-link @ActiveFor("Operations", "Virement")" asp-controller="Operations" asp-action="Virement"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h15M15 4l4 4-4 4M20 16H5m4-4-4 4 4 4" /></svg><span data-i18n="nav.transfer">Virement</span></a>
                    <a class="bank-nav-link @ActiveFor("VirementsInterAgences")" asp-controller="VirementsInterAgences" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 21h18M5 21V8l7-4 7 4v13M9 12h6M9 16h6M3 8h18" /></svg><span data-i18n="nav.interbranch">Virements interagences</span></a>
                    <a class="bank-nav-link @ActiveFor("Prets")" asp-controller="Prets" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg><span data-i18n="nav.loans">Prêts</span></a>
                    <a class="bank-nav-link @ActiveFor("Cartes")" asp-controller="Cartes" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v13H3zM3 10h18M7 15h4" /></svg><span data-i18n="nav.cards">Cartes</span></a>
                }
                else if (isClient && clientHasActiveAccount)
                {
                    <a class="bank-nav-link @ActiveFor("Cartes")" asp-controller="Cartes" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v13H3zM3 10h18M7 15h4" /></svg><span data-i18n="nav.cards">Ma carte et mes opérations</span></a>
                }

                @if (User.IsInRole("gestionnaire"))
                {
                    <a class="bank-nav-link @ActiveFor("Conformite")" asp-controller="Conformite" asp-action="Alertes"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11ZM12 8v4M12 16h.01" /></svg><span data-i18n="nav.aml">Alertes AML</span></a>
                }
                @if (User.IsInRole("admin"))
                {
                    <p class="sidebar-section-label" data-i18n="nav.administration">ADMINISTRATION</p>
                    <a class="bank-nav-link @ActiveFor("Operations", "EnAttenteValidation")" asp-controller="Operations" asp-action="EnAttenteValidation"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6M3 3h18v18H3z" /></svg><span data-i18n="nav.amlApprovals">Approbations AML</span></a>
                    <a class="bank-nav-link @ActiveFor("AdminUtilisateurs")" asp-controller="AdminUtilisateurs" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 8v6M23 11h-6" /></svg><span data-i18n="nav.users">Utilisateurs</span></a>
                    <a class="bank-nav-link @ActiveFor("Conformite")" asp-controller="Conformite" asp-action="Alertes"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11ZM12 8v4M12 16h.01" /></svg><span data-i18n="nav.aml">Alertes AML</span></a>
                    <a class="bank-nav-link @ActiveFor("Compensations")" asp-controller="Compensations" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h13M12 3l4 4-4 4M21 17H8m4-4-4 4 4 4" /></svg><span data-i18n="nav.compensations">Compensations</span></a>
                    <a class="bank-nav-link @ActiveFor("CNRF")" asp-controller="CNRF" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8" /></svg><span data-i18n="nav.cnrf">CNRF</span></a>
                    <a class="bank-nav-link @ActiveFor("SeuilsAML")" asp-controller="SeuilsAML" asp-action="Index"><svg class="bank-nav-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" /></svg><span data-i18n="nav.amlThresholds">Seuils AML</span></a>
                }
                <p class="sidebar-section-label">INFORMATIONS</p>
                <a class="bank-nav-link @ActiveFor("Home", "About")" asp-controller="Home" asp-action="About"><span>À propos de nous</span></a>
                <a class="bank-nav-link @ActiveFor("Home", "Contact")" asp-controller="Home" asp-action="Contact"><span>Contactez-nous</span></a>
                <a class="bank-nav-link @ActiveFor("Home", "Settings")" asp-controller="Home" asp-action="Settings"><span data-i18n="nav.settings">Paramètres</span></a>
            </nav>

            <div class="sidebar-footer"><span class="sidebar-status-dot"></span><span data-i18n="nav.systemOperational">Système opérationnel</span></div>
        </aside>

        <div class="bank-main-column">
            <header class="bank-topbar no-print">
                <div class="topbar-context"><span data-i18n="nav.workspace">Espace bancaire</span><span class="topbar-divider">/</span><strong data-page-title="@(currentController).@(currentAction)">@ViewData["Title"]</strong></div>
                <div class="bank-navbar-account @(isManagePage ? "is-manage-page" : string.Empty)"><partial name="_LoginPartial" /></div>
            </header>
            <main class="bank-layout-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <header class="bank-anonymous-header"><a class="bank-brand" asp-area="Identity" asp-page="/Account/Login"><span class="bank-brand-mark" aria-hidden="true">AK</span><span class="bank-brand-copy"><strong>AkarangaBank</strong></span></a></header>
    <main class="bank-anonymous-content">@RenderBody()</main>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
